# Database connection URL. Defaults to SQLite if not set.
# Examples:
#   SQLite (dev): sqlite:///./recipes.db
#   Postgres: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./recipes.db

# JWT secret used for signing tokens. If empty, a secure random value is generated at runtime (dev only).
JWT_SECRET=
